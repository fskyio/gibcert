# ACME DNS-01 example using a gibdns provider.
#
# gibcert executes the configured argv without a shell or method argument. The
# provider reads one gibdns JSON request from stdin and writes one response to
# stdout. See docs/exec-dns-providers.md.

account letsencrypt {
	ca letsencrypt
	email admin@example.com
}

provider custom-dns {
	type dns
	driver exec
	command /usr/local/libexec/example-gibdns --profile production
	zone example.com
	api_url https://dns.example.net

	secret token {
		file /etc/gibcert/custom-dns-token
	}
}

certificate wildcard-example.com {
	account letsencrypt
	names example.com *.example.com

	challenge dns-01 {
		provider custom-dns
		propagation-timeout 120s
	}

	renew {
		before-expiry 30d
	}

	deploy app {
		fullchain /etc/app/tls/example.com/fullchain.pem
		key /etc/app/tls/example.com/privkey.pem
		owner root
		group app
		mode 0640
		after "systemctl reload app"
	}
}
